# Copy this file to <repository>/.env and fill the three blank values below.
# ADE CLI reads .env; exported process variables take precedence, even if empty.
# Use KEY=value, with comments on separate lines; no export or shell expansion.
# Never commit .env. Field reference: docs/en/deployment.md.

# W&B user/team slug owning the project, not a project name or URL.
WANDB_ENTITY=

# W&B API server. Keep this for hosted W&B; replace for your self-hosted instance.
WANDB_BASE_URL=https://api.wandb.ai

# API key from that W&B instance, with write access to WANDB_ENTITY.
WANDB_API_KEY=

# A private random string you generate for ADE's local Judge gateway.
# The deployment's authorization_env names this variable; it does not contain the secret.
ADE_LOCAL_JUDGE_AUTHORIZATION=

# Codex login is configured separately for the operating account; see Quickstart.
# ADE generates W&B project/run IDs and RAY_ADDRESS from Run/deployment configuration.
